AUTH_SECRET="로컬 개발용 시크릿"

# 셸 ↔ 훈련(class-management)·통독 SSO JWT (HS256). 훈련·통독 앱과 동일 값. 실제 비밀은 커밋하지 않음.
# PLATFORM_SSO_SECRET=""

# Firestore (서버, firebase-admin)
FIREBASE_PROJECT_ID="demo-mokyang-flow"
# FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
# FIREBASE_STORAGE_EMULATOR_HOST="127.0.0.1:9199"
FIREBASE_STORAGE_BUCKET="demo-mokyang-flow.appspot.com"

# 리더 모임 교안·해설지·악보 (Vercel Blob, 비공개 스토어 연결 시 자동 주입)
# BLOB_READ_WRITE_TOKEN=""
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-...@....iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 웹 푸시 FCM (브라우저 공개 설정 — sorting-hat과 동일 Firebase 프로젝트면 public/sorting-hat/firebase-config.js 값 참고)
# NEXT_PUBLIC_FIREBASE_API_KEY=""
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
# NEXT_PUBLIC_FIREBASE_APP_ID=""
# Firebase 콘솔 → Cloud Messaging → Web Push certificates → Key pair
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# Vercel Cron → GET /api/cron/attendance-reminder (Authorization: Bearer …)
# CRON_SECRET=""

# 훈련(class-management) same-domain 프록시 — origin만 (path 없음). docs/platform-training-rewrite.md
# TRAINING_ORIGIN="https://class-management-chi-amber.vercel.app"
# CLASS_MANAGEMENT_URL=""  # TRAINING_ORIGIN alias
# TRAINING_ORIGIN=""      # 빈 값이면 /training rewrite 비활성 (로컬 기본)

# 통독(tongdok-mu) same-domain 프록시 — origin만 (path 없음). docs/platform-tongdok-rewrite.md
# TONGDOK_ORIGIN="https://tongdok-mu.vercel.app"
# TONGDOK_ORIGIN=""       # 빈 값이면 /tongdok rewrite 비활성 (로컬 기본)

# 투표일 홈 배너가 연결하는 poll 사이트 (미설정 시 https://leessosso.github.io/poll/)
# POLL_SITE_URL="https://leessosso.github.io/poll/"
